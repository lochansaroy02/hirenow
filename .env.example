# Local PostgreSQL, or a hosted connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_mailer?schema=public"

# Gmail is NOT configured here. Each user connects their own Gmail account in
# Settings after signing in, and campaigns send from that account.

# ImageKit stores the resume PDF that gets attached to every email.
# Private key: https://imagekit.io/dashboard/developer/api-keys
# Leave blank to fall back to storing resumes on this machine instead.
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional. Defaults to /hirenow/resumes
IMAGEKIT_FOLDER="/hirenow/resumes"

# Signs session cookies and encrypts saved Gmail App Passwords. Required: at least
# 32 random characters. Changing it signs everyone out and users must re-enter
# their App Password in Settings.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""
